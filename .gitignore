# Go binaries dropped at the repo root. build.sh emits ./gopher; a bare
# `go build ./cmd/<x>` emits ./<x> named after the package dir (agent, server,
# dnsprobe). Leading slashes anchor to the root so these can't match the
# cmd/<x>/ SOURCE directories. Prefer `go build ./...` (compiles, no output) or
# `go build -o /dev/null ./cmd/<x>` to avoid littering in the first place.
gopher
gopher.exe
/agent
/server
/dnsprobe

# Database
*.db
*.db-shm
*.db-wal

# Frontend dependencies
frontend/node_modules/

# Frontend build output (embedded into Go binary via go:embed; produced by build.sh)
cmd/server/frontend/dist/
cmd/server/frontend

# Cross-compiled agent binaries (embedded into Go binary via go:embed; produced by build.sh).
# .gitkeep is kept so the directory survives for go:embed on fresh checkouts.
cmd/server/agents/gopher-agent-*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.test
coverage.out

# Temporary files
/tmp/

# Fetched embedded binaries (populated by scripts/fetch-deps.sh, embedded via go:embed).
# Ignore everything in bin/ except the committed .gitkeep that keeps the dir
# present for go:embed on fresh checkouts.
internal/embedbin/bin/*
!internal/embedbin/bin/.gitkeep

[server]
bind_addr = "0.0.0.0:2333"

[server.default_token]
default_token = "changeme"

{{range .Tunnels}}
[server.services.tunnel-{{.ID}}]
token = "{{.RatholeToken}}"
bind_addr = "0.0.0.0:{{.RatholePort}}"
{{end}}
{{range .Machines}}{{if .RatholeSSHToken}}
[server.services.machine-{{.ID}}-ssh]
type = "tcp"
token = "{{.RatholeSSHToken}}"
bind_addr = "0.0.0.0:{{.TunnelPort}}"
{{end}}{{end}}

# ===== BEGIN CUSTOM CONFIGURATION =====
# Everything below this line will NOT be overwritten on deploy.
# Add any custom rathole service entries here.
# ===== END CUSTOM CONFIGURATION =====
